{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "movies": {
        "ClusterId": "movies-migration",
        "Order": 1,
        "Match": {
          "Path": "/api/movies/{**catch-all}"
        }
      },
      "events": {
        "ClusterId": "events",
        "Order": 1,
        "Match": {
          "Path": "/api/events/{**catch-all}"
        }
      },
      "monolith": {
        "ClusterId": "monolith",
        "Order": 100,
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "movies-migration": {
        "LoadBalancingPolicy": "MoviesMigration",
        "Destinations": {
          "monolith": {
            "Address": "{{MONOLITH_URL}}"
          },
          "movies": {
            "Address": "{{MOVIES_SERVICE_URL}}"
          }
        }
      },
      "events": {
        "Destinations": {
          "events": {
            "Address": "{{EVENTS_SERVICE_URL}}"
          }
        }
      },
      "monolith": {
        "Destinations": {
          "monolith": {
            "Address": "{{MONOLITH_URL}}"
          }
        }
      }
    }
  }
}
